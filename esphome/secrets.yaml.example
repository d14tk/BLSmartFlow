wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
# Password of the fallback hotspot the device opens when it cannot join your WiFi (min. 8 characters)
fallback_ap_password: "change-me-please"
# Generate with: openssl rand -base64 32   (Home Assistant asks for it when adding the device)
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "change-me-too"
